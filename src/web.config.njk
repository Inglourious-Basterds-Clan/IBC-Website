{#- D-16 minimal IIS config: the 404 page (pathPrefix-aware, server-relative as ExecuteURL needs)
    and the .webmanifest MIME type. Each entry is preceded by a <remove>, so IIS never answers
    500.19 for a duplicate. No URL Rewrite, redirects or errorMode: those are server setup. -#}
<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- GitHub Pages ignores this file; IIS reads it (and never serves it). -->
  <system.webServer>
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="{{ '/404.html' | htmlBaseUrl }}" responseMode="ExecuteURL" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
