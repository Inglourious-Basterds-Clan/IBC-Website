  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# D-01: the home uses its full title as is; D-02: every other page gets " | IBC" (site name when untitled) #}
  {%- set isHome = page.url == "/" %}
  {%- set fullTitle = (title or site.name) if isHome else ((title or site.name) ~ " | " ~ site.shortName) %}
  {#- HtmlBasePlugin never rewrites <meta content>, so share URLs are made absolute here (D-07) #}
  {%- set canonical = page.url | htmlBaseUrl(site.url) %}
  {%- set ogImageUrl = (ogImage or site.ogImage) | htmlBaseUrl(site.url) %}
  {#- The default alt describes the default card only: a page with its own ogImage needs its own ogImageAlt, else no alt tag (WR-01) #}
  {%- set ogImageAltText = (ogImageAlt if ogImage else site.ogImageAlt) %}

  <!-- SEO Meta Tags -->
  <title>{{ fullTitle }}</title>
  <link rel="canonical" href="{{ canonical }}">
  {% if not site.indexable or not (page.url | isIndexableUrl) %}<meta name="robots" content="noindex">{% endif %}
  {#- todo is one FACTS-NN id or a list of them; each becomes its own marker (IN-08) #}
  {% if todo %}{% for id in ([todo] if todo is string else todo) %}<!-- TODO({{ id }}) -->{% endfor %}{% endif -%}
  {# D-04: description comes from front matter only, no site-wide fallback #}
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}

  <!-- Stylesheets & Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Open Graph & Twitter Cards -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ fullTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImageUrl }}">
  {% if not ogImage %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% elif ogImageWidth and ogImageHeight %}<meta property="og:image:width" content="{{ ogImageWidth }}">
  <meta property="og:image:height" content="{{ ogImageHeight }}">
  {% endif %}{% if ogImageAltText %}<meta property="og:image:alt" content="{{ ogImageAltText }}">
  {% endif %}<meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  <meta name="twitter:image" content="{{ ogImageUrl }}">
  {% if ogImageAltText %}<meta name="twitter:image:alt" content="{{ ogImageAltText }}">{% endif %}

  <!-- Icons, Manifest & Theme -->
  {# D-08: rose on the dark tile; Google wants a square icon above 48 px and lists no SVG #}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/assets/icons/icon-192.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="{{ site.themeColor }}">

  <!-- Structured Data JSON-LD -->
  {# D-14: Organization + WebSite on the home page only; jsonLd escapes "<", so this is the head's only safe #}
  {% if isHome %}<script type="application/ld+json">{{ site | schemaGraph | jsonLd | safe }}</script>{% endif %}
