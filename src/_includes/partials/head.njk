  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {# D-01: the home uses its full title as is; D-02: every other page gets " | IBC" (site name when untitled) #}
  {%- set isHome = page.url == "/" %}
  {%- set fullTitle = (title or site.name) if isHome else ((title or site.name) ~ " | " ~ site.shortName) %}

  <!-- SEO Meta Tags -->
  <title>{{ fullTitle }}</title>
  <link rel="canonical" href="{{ page.url | htmlBaseUrl(site.url) }}">
  {% if not site.indexable or not (page.url | isIndexableUrl) %}<meta name="robots" content="noindex">{% endif %}
  {% if todo %}<!-- TODO({{ todo }}) -->{% endif -%}
  {# D-04: description comes from front matter only, no site-wide fallback #}
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}

  <!-- Stylesheets & Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Open Graph & Twitter Cards -->
  <meta property="og:title" content="IBC Clan // Wizytówka Taktyczna Arma 3">
  <meta property="og:description" content="Oficjalna strona klanu IBC w Arma 3. Dołącz do naszej społeczności milsim, bierz udział w zorganizowanych operacjach i przeżyj realistyczną symulację pola walki.">
  <meta property="og:image" content="{{ "/assets/hero-bg.jpg" | htmlBaseUrl(site.url) }}">
  <meta property="og:type" content="website">
  
  <!-- Structured Data JSON-LD -->
  {% if page.url == "/" %}<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SportsTeam",
    "name": "Inglourious Basterds Clan (IBC)",
    "sport": "Arma 3 Milsim",
    "foundingDate": "2018",
    "description": "Taktyczna symulacja militarna (Milsim) w grze Arma 3. Realistyczne operacje bojowe i misje kooperacyjne."
  }
  </script>{% endif %}
