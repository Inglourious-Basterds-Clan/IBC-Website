  <header>
    <div class="nav-container">
      <div class="logo">
        <a href="/#hero">
          {% picture images.logo, { "alt": "IBC Logo", "class": "logo-img", "sizes": "50px", "loading": "lazy", "decoding": "async" } %}
          <div class="logo-text">
            <span>Inglourious</span>
            <span>Basterds</span>
            <span>Clan</span>
          </div>
        </a>
      </div>
      <button class="menu-toggle" data-js="menu" aria-label="Przełącz menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="header-actions">
        <nav data-js="scroll-spy">
          <ul id="mobile-nav">
            {% for item in navigation %}
            <li><a href="{{ item.href }}"{% if page.url == "/" and loop.first %} class="active-nav"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        {% include "partials/discord-cta.njk" %}
      </div>
    </div>
  </header>
